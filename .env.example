POSTGRES_DB=trip_diary
POSTGRES_USER=trip_diary
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/trip_diary
DATABASE_USERNAME=trip_diary
DATABASE_PASSWORD=change-me-for-local-development
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
CORS_ALLOWED_ORIGIN_PATTERNS=https://app.example.com
KAKAO_REST_API_KEY=replace-with-kakao-rest-api-key

# Export these into the backend process; Spring Boot does not load .env automatically.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials:
AWS_SESSION_TOKEN=
AWS_REGION=ap-northeast-2
S3_BUCKET=trip-diary-images-2026-916912096488-ap-northeast-2-an
S3_PRESIGN_TTL=5m

# Optional error monitoring. Keep blank until a Sentry project and release process are ready.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Operations defaults (override only after reviewing docs/phase-11b-operations.md).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_KEYS=20000
RATE_LIMIT_SIGNUP_LIMIT=10
RATE_LIMIT_SIGNUP_WINDOW=10m
RATE_LIMIT_LOGIN_LIMIT=30
RATE_LIMIT_LOGIN_WINDOW=1m
RATE_LIMIT_UPLOAD_URL_LIMIT=60
RATE_LIMIT_UPLOAD_URL_WINDOW=1m
RATE_LIMIT_COMPLETE_LIMIT=120
RATE_LIMIT_COMPLETE_WINDOW=1m
RATE_LIMIT_DIARY_LIMIT=10
RATE_LIMIT_DIARY_WINDOW=1m
RATE_LIMIT_ACCOUNT_LIMIT=5
RATE_LIMIT_ACCOUNT_WINDOW=10m
IMAGE_CLEANUP_ENABLED=false
IMAGE_CLEANUP_PENDING_AGE=24h
IMAGE_CLEANUP_FIXED_DELAY=1h
IMAGE_CLEANUP_BATCH_SIZE=100
