# Android emulator: http://10.0.2.2:8080/api/v1
# iOS simulator/web: http://localhost:8080/api/v1
# Physical device: http://YOUR_PC_LAN_IP:8080/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Leave blank until published HTTPS pages are available (Settings shows "준비 중").
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=

# Optional error monitoring. A DSN is not a secret, but configure it per build environment.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
