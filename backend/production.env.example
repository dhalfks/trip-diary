# Names only. Store real values in the production platform secret store.
# Spring Boot does not load this file automatically.
SPRING_PROFILES_ACTIVE=production

DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set only when temporary AWS credentials are used.
AWS_SESSION_TOKEN=
AWS_REGION=
S3_BUCKET=
S3_PRESIGN_TTL=5m

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# This is the property name used by the application. Use explicit HTTPS origins only.
CORS_ALLOWED_ORIGIN_PATTERNS=

# Optional integrations.
KAKAO_REST_API_KEY=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Review before enabling cleanup in production.
RATE_LIMIT_ENABLED=true
IMAGE_CLEANUP_ENABLED=false
